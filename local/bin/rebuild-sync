#!/usr/bin/env fish
# nixbuild — NixOS rebuild + secure dotfile backup + git sync
#
# Behavior:
#   1. Stages NixOS flake files, then rebuilds NixOS. Aborts on failure.
#   2. Rsyncs config files to $BACKUP_DIR with recoverable deletes.
#   3. Scans staged changes for secrets (gitleaks).
#   4. Commits, rebases onto remote, pushes with retry.
#   5. Notifies on push failure; marks pending push for next run.
#
# Run as your normal user (not root). `sudo` is invoked only for the rebuild.
#
# Any command-line arguments are forwarded to `nixos-rebuild switch` (this
# script takes none of its own). Use it for things like `--show-trace` or
# `--option`. If that ever changes, switch to argparse and use `--` to
# separate script flags from nixos-rebuild flags.

# ─── Config ──────────────────────────────────────────────────────────────
set -g BACKUP_DIR   "$HOME/.sysbackup"
set -g LOG_FILE     "$BACKUP_DIR/backup.log"
set -g TRASH_DIR    "$BACKUP_DIR/.trash"
set -g PENDING_FILE "$BACKUP_DIR/.push_pending"
set -g LOCK_FILE    "$BACKUP_DIR/.lock"
set -g REMOTE       "origin"
set -g BRANCH       "main"
set -g PUSH_RETRIES 3

# Source of the NixOS flake (git repo). This is what gets staged before
# rebuild and rsynced into the backup.
set -g FLAKE_DIR    "$HOME/.config/nixos"

# ─── Logging ─────────────────────────────────────────────────────────────
# Logs everything to file; only critical steps to stdout.
function log_message -a level message
    set -l ts (date "+%Y-%m-%d %H:%M:%S")
    set -l line "$ts [$level] $message"
    echo $line >> $LOG_FILE

    switch $level
        case STEP OK WARN ERROR
            set -l color normal
            switch $level
                case OK;    set color green
                case WARN;  set color yellow
                case ERROR; set color red
                case STEP;  set color cyan
            end
            if isatty stdout
                set_color $color
                echo $line
                set_color normal
            else
                echo $line
            end
        case INFO
            # INFO is file-only.
    end
end

function notify -a title body
    # notify-send needs a session bus; skip over SSH / headless sessions.
    if not command -sq notify-send
        return
    end
    if not set -q DISPLAY; and not set -q WAYLAND_DISPLAY
        return
    end
    notify-send -a "nixbuild" -u normal "$title" "$body"
end

# ─── Preconditions ───────────────────────────────────────────────────────
if test (id -u) -eq 0
    echo "nixbuild: do not run as root. Run as your normal user; sudo is used internally." >&2
    exit 1
end

if not mkdir -p $BACKUP_DIR $TRASH_DIR
    echo "nixbuild: cannot create $BACKUP_DIR" >&2
    exit 1
end
test -f $LOG_FILE; or touch $LOG_FILE

# Ensure runtime state never gets committed.
touch $BACKUP_DIR/.gitignore
for entry in '.trash/' '.push_pending' '.lock'
    if not grep -qxF $entry $BACKUP_DIR/.gitignore 2>/dev/null
        echo $entry >> $BACKUP_DIR/.gitignore
    end
end

# Concurrency guard: re-exec under flock. NIXBUILD_LOCKED sentinel stops
# infinite recursion. `flock -n` exits immediately if another instance
# holds the lock. We canonicalize the script path so the re-exec works
# even when the script was found via PATH or a symlink.
if command -sq flock
    if not set -q NIXBUILD_LOCKED
        set -lx NIXBUILD_LOCKED 1
        set -l self (status filename)
        if command -sq realpath
            set self (realpath $self)
        end
        exec flock -n $LOCK_FILE $self $argv
    end
else
    log_message WARN "flock not available — skipping concurrency guard."
end

log_message STEP "Starting NixOS rebuild..."

# ─── 1. Rebuild ──────────────────────────────────────────────────────────
# Flakes require files to be tracked by git. Stage changes in the flake
# repo so the flake sees them. Don't fail hard if it's not a git repo —
# the rebuild will surface that if it matters.
if git -C $FLAKE_DIR add .
    # Check if there are staged changes; if so, commit them to clear the dirty warning
    if not git -C $FLAKE_DIR diff --staged --quiet
        git -C $FLAKE_DIR commit -m "auto: pre-rebuild commit" >/dev/null 2>&1
    end
else
    log_message WARN "Could not stage $FLAKE_DIR (not a git repo?). Continuing."
end

# Flake attribute: default to hostname; override with NIXBUILD_FLAKE_HOST.
# `flake_host` is declared here, then *updated* (without -l) inside the
# branch below — `set -l` inside an `if` would shadow it and be lost.
set -l flake_host (hostname | string collect)
if set -q NIXBUILD_FLAKE_HOST
    set flake_host $NIXBUILD_FLAKE_HOST
end

# Pipe through `nom` if available. fish has no pipefail by default, so we
# capture nixos-rebuild's exit status explicitly via $pipestatus (the
# pipeline's $status would be nom's).
set -l rebuild_rc 0
if command -sq nom
    sudo nixos-rebuild switch --flake $FLAKE_DIR#$flake_host --log-format internal-json $argv |& nom --json
    set rebuild_rc $pipestatus[1]
else
    sudo nixos-rebuild switch --flake $FLAKE_DIR#$flake_host --log-format internal-json $argv
    set rebuild_rc $status
end

if test $rebuild_rc -ne 0
    log_message ERROR "NixOS rebuild failed (rc=$rebuild_rc). Aborting backup."
    notify "NixOS rebuild failed" "Backup skipped. See $LOG_FILE"
    exit 1
end

log_message OK "Rebuild successful."

# ─── 2. Rsync ────────────────────────────────────────────────────────────
# Pairs of "source dest".
set -l syncs \
    $FLAKE_DIR/                           $BACKUP_DIR/nixos/ \
    $HOME/.config/mpv/                    $BACKUP_DIR/config/mpv/ \
    $HOME/.config/hypr/                   $BACKUP_DIR/config/hypr/ \
    $HOME/.config/fish/                   $BACKUP_DIR/config/fish/ \
    $HOME/.local/bin/                     $BACKUP_DIR/local/bin/

if test (math (count $syncs) % 2) -ne 0
    log_message ERROR "Internal error: syncs list has odd length."
    exit 1
end

# -a              archive (perms, times, symlinks)
# --delete-after  remove dest files not in source, AFTER transfer
# --backup        keep overwritten/deleted files
# --backup-dir    put them in a per-run trash dir (recoverable)
# --exclude       skip VCS/build cruft that doesn't belong in a backup
#
# The flake dir is itself a git repo; without --exclude=.git we would
# rsync a nested .git into the backup repo, which breaks `git add .`
# (gitlink) and bloats the backup. `.direnv/` and `result` are build
# artifacts that shouldn't be tracked either.
set -l run_trash (mktemp -d "$TRASH_DIR/$(date +%Y%m%d-%H%M%S)-XXXXXX")
if test -z "$run_trash"; or not test -d "$run_trash"
    log_message ERROR "Could not create trash dir under $TRASH_DIR. Aborting."
    exit 1
end

set -l rsync_opts -a --delete-after --stats --backup --backup-dir=$run_trash \
                  --exclude=.git --exclude=.direnv/ --exclude=result

set -l sync_failed 0
log_message STEP "Syncing config files..."

for i in (seq 1 2 (count $syncs))
    set -l src $syncs[$i]
    set -l dst $syncs[(math $i + 1)]

    if not test -e $src
        log_message WARN "Source missing: $src (skipping)"
        continue
    end

    mkdir -p (dirname $dst)
    rsync $rsync_opts $src $dst >> $LOG_FILE 2>&1
    set -l rc $status
    switch $rc
        case 0
            log_message OK "Synced: $src"
        case 24
            log_message WARN "Partial sync (files vanished): $src"
        case '*'
            log_message ERROR "Sync failed (rsync rc=$rc): $src"
            set sync_failed 1
    end
end

if test $sync_failed -ne 0
    log_message ERROR "One or more syncs failed. Skipping git."
    notify "Backup sync failed" "See $LOG_FILE"
    exit 1
end

# Clean up empty trash dirs (nothing was overwritten/deleted this run).
if test -d $run_trash
    if test -z (find $run_trash -mindepth 1 -print -quit)
        rmdir $run_trash 2>/dev/null
    end
end

# ─── 3. Stage + secret scan ──────────────────────────────────────────────
# Stage first so gitleaks sees exactly what's about to be committed.
log_message STEP "Staging changes..."
if not git -C $BACKUP_DIR add .
    log_message ERROR "git add failed."
    exit 1
end

log_message STEP "Scanning for secrets..."
if command -sq gitleaks
    gitleaks git $BACKUP_DIR --staged --no-banner --redact --exit-code 1 >> $LOG_FILE 2>&1
    set -l gl_rc $status
    switch $gl_rc
        case 0
            log_message OK "gitleaks: clean."
        case 1
            log_message ERROR "gitleaks found secrets in staged changes. Aborting."
            log_message INFO "Reproduce: gitleaks git $BACKUP_DIR --staged --no-banner --redact"
            notify "Secret scan failed" "Backup aborted — check $LOG_FILE"
            exit 1
        case '*'
            log_message ERROR "gitleaks errored (rc=$gl_rc). Aborting to be safe."
            log_message INFO "Check that your gitleaks version supports 'git --staged'."
            notify "Secret scan errored" "gitleaks rc=$gl_rc — check $LOG_FILE"
            exit 1
    end
else
    log_message WARN "gitleaks not installed — skipping secret scan."
end

# ─── 4. Commit ───────────────────────────────────────────────────────────
set -l changes (git -C $BACKUP_DIR status --porcelain | wc -l | string trim)
if test -z "$changes"
    set changes 0
end

if test "$changes" -gt 0
    set -l host   (hostname | string collect)
    set -l nixver (nixos-version 2>/dev/null | string collect; or echo unknown)
    set -l msg "backup: post-rebuild sync "(date "+%Y-%m-%d %H:%M:%S")"
Host: $host
NixOS: $nixver
Files changed: $changes"

    if not git -C $BACKUP_DIR commit -m "$msg" >> $LOG_FILE 2>&1
        log_message ERROR "git commit failed."
        exit 1
    end
    log_message OK "Committed $changes file(s)."
else
    log_message INFO "No changes to commit."
end

# ─── 5. Rebase + push (with retry and notification) ──────────────────────
log_message STEP "Syncing with remote..."

set -l pending_push 0
test -f $PENDING_FILE; and set pending_push 1

set -l dirty (git -C $BACKUP_DIR status --porcelain)
if test (count $dirty) -gt 0
    log_message INFO "Post-commit tree changes:"
    for line in $dirty
        log_message INFO "  $line"
    end
end

set -l remote_has_branch 1
if not git -C $BACKUP_DIR ls-remote --exit-code $REMOTE $BRANCH >/dev/null 2>&1
    set remote_has_branch 0
    log_message WARN "Remote branch $REMOTE/$BRANCH not found — skipping pull."
end

if test $remote_has_branch -eq 1
    if not git -C $BACKUP_DIR pull --rebase --autostash $REMOTE $BRANCH >> $LOG_FILE 2>&1
        log_message ERROR "Rebase failed (conflict or network). Manual resolution required."
        notify "Backup rebase failed" "Resolve in $BACKUP_DIR"
        git -C $BACKUP_DIR rebase --abort 2>/dev/null
        exit 1
    end
end

set -l pushed 0
for attempt in (seq 1 $PUSH_RETRIES)
    if git -C $BACKUP_DIR push $REMOTE $BRANCH >> $LOG_FILE 2>&1
        set pushed 1
        break
    end
    if test $attempt -lt $PUSH_RETRIES
        set -l delay (math -s0 "2 ^ $attempt")   # 2s, 4s, 8s
        log_message WARN "Push attempt $attempt failed. Retrying in {$delay}s..."
        sleep $delay
    end
end

if test $pushed -eq 1
    log_message OK "Pushed to $REMOTE/$BRANCH."
    if test $pending_push -eq 1
        rm -f $PENDING_FILE
        log_message INFO "Cleared pending-push marker."
    end
else
    log_message ERROR "Push failed after $PUSH_RETRIES attempts. Commit is local."
    touch $PENDING_FILE
    notify "Backup push failed" "Commit saved locally; will retry next run. Check network."
    log_message WARN "Marked pending push. Next nixbuild will retry."
    exit 0
end

log_message STEP "Backup completed successfully."
